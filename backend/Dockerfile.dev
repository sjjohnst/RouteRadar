# Backend dev Dockerfile — runs the FastAPI app with Uvicorn (not Lambda runtime)
# Use this with docker-compose.dev.yml for local development.
# The production Dockerfile uses CMD ["main.handler"] for the Lambda runtime.
# Titiler custom API Dockerfile
FROM ghcr.io/developmentseed/titiler:2.2.1

# WORKDIR must be /app to match the docker-compose bind mount (./backend:/app).
# Without it, COPY lands the app at / and uvicorn resolves "main:app" from CWD /,
# so the container runs the image's baked-in copy and the bind mount is ignored —
# i.e. --reload silently does nothing and code edits only apply on --build.
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "titiler-application==1.1.1" "mangum>=0.10.0" uvicorn[standard]

COPY __init__.py state.py routers.py main.py ./

# GDAL/VSI tuning. Kept deliberately close to the production Dockerfile so
# local timings are representative; see the notes on the memory-sensitive vars.
#
# WEB_CONCURRENCY is intentionally absent: uvicorn ignores it when --reload is
# set ("workers flag is ignored when reloading is enabled"), so it was dead
# config that implied a parallelism this container never had. One worker per
# container also matches Lambda, which serves one request per container.
#
# VSI_CACHE_SIZE is PER FILE HANDLE, not global (GDAL default: 25 MB). The
# previous value of 512 MB multiplied by the number of COGs opened concurrently
# for a single tile, which was enough to OOM the host. Left at the default.
ENV PYTHONPATH=/app \
    GDAL_CACHEMAX=512 \
    GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR \
    CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif,.tiff,.vrt,.ovr,.json \
    GDAL_HTTP_MERGE_CONSECUTIVE_RANGES=YES \
    GDAL_HTTP_MULTIPLEX=YES \
    GDAL_HTTP_VERSION=2 \
    GDAL_BAND_BLOCK_CACHE=HASHSET \
    CPL_VSIL_CURL_CACHE_SIZE=200000000

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
